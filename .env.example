# ============================================================================
# chrome-devtools-mcp — variables d'environnement
# ============================================================================
# Copier en .env et renseigner les valeurs. Jamais de secret en dur dans le dépôt.
# ============================================================================

# --- Authentification --------------------------------------------------------
# Clé maître générée par Onyxia (service.oneTimePassword)
# Utilisée pour authentifier /mcp et /view
CDM_API_KEY=<à définir par Onyxia>

# --- Sessions ---------------------------------------------------------------
# Plafond de sessions simultanées (défaut 3)
CDM_MAX_SESSIONS=3

# Durée d'inactivité avant expiration d'une session en secondes (défaut 1800 = 30 min)
CDM_SESSION_TIMEOUT=1800

# --- Réseau -----------------------------------------------------------------
# Modèles d'URL autorisés (CSV, vide = aucune autorisation)
# Les adresses internes du cluster sont refusées par défaut
CDM_ALLOWED_URL_PATTERNS=https://*.example.com

# Modèles d'URL bloqués (CSV, priorité sur allowlist)
CDM_BLOCKED_URL_PATTERNS=

# --- Lanceur ----------------------------------------------------------------
# Canal Chrome : chrome (vrai Chrome) ou chromium (Chromium)
CDM_CHANNEL=chrome

# Profils persistants (dossier sur PVC)
CDM_PROFILE_DIR=/data/profiles

# Catégorie d'outils à exclure (optionnel, par défaut toutes incluses)
# Désactiver les catégories inutiles pour rester sous ~20 outils :
CDM_DISABLED_CATEGORIES=extensions,pwa,experimental-third-party

# --- Serveur ----------------------------------------------------------------
# Port d'écoute du serveur HTTP (défaut 3100)
CDM_PORT=3100

# Adresse de liaison (défaut 0.0.0.0, utiliser 127.0.0.1 pour un accès local uniquement)
CDM_HOST=0.0.0.0
